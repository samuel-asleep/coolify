# Minimal Environment Configuration for External Services
# This template shows the minimal required configuration when using external PostgreSQL and Redis

# ==========================================
# REQUIRED: Database Configuration
# ==========================================
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ==========================================
# REQUIRED: Redis Configuration  
# ==========================================
# For TLS-enabled Redis (e.g., Upstash), use rediss://
REDIS_URL=rediss://default:password@host:6379

# ==========================================
# Application Basics (auto-generated if not provided)
# ==========================================
APP_ENV=production
APP_NAME=Coolify
APP_ID=production
APP_KEY=base64:GENERATE_WITH_openssl_rand_base64_32
APP_URL=http://localhost:8000
APP_DEBUG=false

# ==========================================
# Optional: Soketi/Pusher (for real-time features)
# ==========================================
PUSHER_APP_ID=coolify-app-id
PUSHER_APP_KEY=coolify-app-key
PUSHER_APP_SECRET=coolify-app-secret
SOKETI_DEFAULT_APP_ID=coolify-app-id
SOKETI_DEFAULT_APP_KEY=coolify-app-key
SOKETI_DEFAULT_APP_SECRET=coolify-app-secret

# ==========================================
# Optional: Queue/Cache (defaults to redis)
# ==========================================
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_DRIVER=redis

# ==========================================
# Optional: Mail (defaults to log)
# ==========================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@coolify.io

# ==========================================
# Optional: PHP Settings
# ==========================================
PHP_MEMORY_LIMIT=256M
